# Python
__pycache__/
*.py[cod]
.venv/

# Runtime artifacts carrying live session material.
# calendar_url_cache.txt holds the `s=` token; debug_responses/ holds raw server
# responses verbatim — session cookies, `s=` tokens, and on the emailed leg the
# applicant's 記号/番号/カナ氏名/生年月日, which 申込内容確認画面 echoes back.
calendar_url_cache.txt
chrome_user_agent.txt
debug_responses/
# Both caches are written tmp-then-rename; a kill mid-write leaves the token in
# the .tmp sibling.
*.tmp

# The log is credential-bearing, and rotation renames it to its_booking.log.1,
# which `*.log` alone would miss.
*.log
*.log.*

# Holds (each lapses unless the emailed link was followed) and confirmed
# reservations with their 申込受付番号 — an entry in the latter means a real
# cancellation liability exists.
holds.json
reservations.json

# Applicant identity (記号/番号/カナ氏名/生年月日) and the Gmail app password reach
# the program only through the environment. This repository's history is on a
# public remote, so anything of that shape stays out.
.env
.env.*
*.env
